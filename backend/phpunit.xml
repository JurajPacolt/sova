<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="SOVA backend">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="LOG_LEVEL" value="error" force="true"/>
        <env name="LOG_PATH" value="php://stderr" force="true"/>
        <env name="AUTH_COOKIE_SECURE" value="false" force="true"/>
        <env name="AUTH_RATE_LIMIT_SECRET" value="sova-test-rate-limit-secret" force="true"/>
        <env name="SENSITIVE_PAYLOAD_KEY_ID" value="test-v1" force="true"/>
        <env name="SENSITIVE_PAYLOAD_KEY" value="MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=" force="true"/>
        <env name="MAILER_DSN" value="null://null" force="true"/>
        <env name="MAILER_FROM" value="noreply@example.test" force="true"/>
    </php>
</phpunit>
