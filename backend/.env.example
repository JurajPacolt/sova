APP_NAME="SOVA API"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=dev
APP_PUBLIC_URL=http://localhost:4200

LOG_LEVEL=debug
LOG_PATH=php://stderr

# The application role must be NOSUPERUSER and NOBYPASSRLS: a role that bypasses
# row level security makes the tenant isolation policies inert without any error
# (ADR 0010). The readiness endpoint reports it, and in production refuses.
DATABASE_DRIVER=pdo_pgsql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sova
DATABASE_USER=sova
DATABASE_PASSWORD=sova_dev_password
DATABASE_SERVER_VERSION=17
DATABASE_SSL_MODE=prefer

# DATABASE_URL=postgresql://sova:sova_dev_password@127.0.0.1:5432/sova

AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-local-secret
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
AUTH_RATE_LIMIT_IP_ATTEMPTS=20
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_INVITATION_TTL_SECONDS=604800
AUTH_INVITATION_RESEND_COOLDOWN_SECONDS=60
AUTH_RECOVERY_REQUEST_TTL_SECONDS=900
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_RECOVERY_RATE_LIMIT_BLOCK_SECONDS=3600
AUTH_RECOVERY_RATE_LIMIT_ACCOUNT_REQUESTS=3
AUTH_RECOVERY_RATE_LIMIT_IP_REQUESTS=20

# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SENSITIVE_PAYLOAD_KEY_ID=local-v1
SENSITIVE_PAYLOAD_KEY=replace-with-base64-encoded-32-byte-key

# Attachment bytes are stored on disk, never in the database. The directory MUST
# stay outside anything the web server serves directly, or a file could be fetched
# without passing the download authorisation. The default sits under backend/var,
# which is neither served nor committed.
ATTACHMENT_STORAGE_PATH=var/attachments
ATTACHMENT_TENANT_QUOTA_BYTES=21474836480

# Malware scanner. With "none" an upload is recorded as SKIPPED rather than clean,
# so the gap is visible in the data. Production refuses to start with "none", the
# same way it refuses a null mail transport.
ATTACHMENT_SCANNER=none
# With ATTACHMENT_SCANNER=clamav, the API streams bytes to clamd over INSTREAM.
ATTACHMENT_SCANNER_HOST=127.0.0.1
ATTACHMENT_SCANNER_PORT=3310
ATTACHMENT_SCANNER_CONNECT_TIMEOUT_MS=1000
ATTACHMENT_SCANNER_READ_TIMEOUT_SECONDS=30

# Grace window in which a comment author may still edit their own comment.
# Beyond it, and for anyone else's comment, `comment.moderate` decides.
COMMENT_EDIT_WINDOW_SECONDS=900

# SovaQL safety limits. Every value has a working default, so these only need to be
# set when operations tune them. Note that the AST node budget is the stricter of
# SEARCH_MAX_AST_NODES and SEARCH_MAX_IN_VALUES, so one IN fits at most
# SEARCH_MAX_AST_NODES - 1 values. Raising a limit must never be used to work around
# the tenant scope or the database statement timeout.
SEARCH_MAX_QUERY_BYTES=8192
SEARCH_MAX_AST_NODES=100
SEARCH_MAX_PAREN_DEPTH=10
SEARCH_MAX_IN_VALUES=100
SEARCH_MAX_SORT_FIELDS=3
SEARCH_DEFAULT_PAGE_SIZE=50
SEARCH_MAX_PAGE_SIZE=100
SEARCH_STATEMENT_TIMEOUT_MS=3000
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
SEARCH_RATE_LIMIT_REQUESTS=120

# Use a local email catcher during development; production must use an authenticated
# TLS SMTP/provider DSN and a verified sender.
MAILER_DSN=null://null
MAILER_FROM=noreply@example.test
OUTBOX_MAX_ATTEMPTS=5

CORS_ALLOWED_ORIGINS=http://localhost:4200
