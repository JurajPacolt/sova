APP_NAME="SOVA API"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=dev

LOG_LEVEL=debug
LOG_PATH=php://stderr

DATABASE_DRIVER=pdo_pgsql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sova
DATABASE_USER=sova
DATABASE_PASSWORD=sova_dev_password
DATABASE_SERVER_VERSION=17
DATABASE_SSL_MODE=prefer

# DATABASE_URL=postgresql://sova:sova_dev_password@127.0.0.1:5432/sova

CORS_ALLOWED_ORIGINS=http://localhost:4200
