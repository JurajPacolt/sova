APP_NAME="SOVA API"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=dev
APP_PUBLIC_URL=http://localhost:4200

LOG_LEVEL=debug
LOG_PATH=php://stderr

DATABASE_DRIVER=pdo_pgsql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sova
DATABASE_USER=sova
DATABASE_PASSWORD=sova_dev_password
DATABASE_SERVER_VERSION=17
DATABASE_SSL_MODE=prefer

# DATABASE_URL=postgresql://sova:sova_dev_password@127.0.0.1:5432/sova

AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-local-secret
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
AUTH_RATE_LIMIT_IP_ATTEMPTS=20
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_INVITATION_TTL_SECONDS=604800
AUTH_RECOVERY_REQUEST_TTL_SECONDS=900
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_RECOVERY_RATE_LIMIT_BLOCK_SECONDS=3600
AUTH_RECOVERY_RATE_LIMIT_ACCOUNT_REQUESTS=3
AUTH_RECOVERY_RATE_LIMIT_IP_REQUESTS=20

# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SENSITIVE_PAYLOAD_KEY_ID=local-v1
SENSITIVE_PAYLOAD_KEY=replace-with-base64-encoded-32-byte-key

# Use a local email catcher during development; production must use an authenticated
# TLS SMTP/provider DSN and a verified sender.
MAILER_DSN=null://null
MAILER_FROM=noreply@example.test
OUTBOX_MAX_ATTEMPTS=5

CORS_ALLOWED_ORIGINS=http://localhost:4200
