# Copy to deploy/staging/.env, replace every CHANGE_ME value, and chmod 600 it.
SOVA_IMAGE_TAG=staging-local
SOVA_PUBLIC_URL=https://sova-staging.example.test
SOVA_HTTP_PORT=8080
SOVA_MAILPIT_PORT=8025
SOVA_TRUSTED_PROXY_CIDRS=127.0.0.1/32

SOVA_POSTGRES_ADMIN_USER=sova_bootstrap
SOVA_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
SOVA_DATABASE_NAME=sova
SOVA_DATABASE_USER=sova_app
SOVA_DATABASE_PASSWORD=CHANGE_ME_APPLICATION_DATABASE_PASSWORD

SOVA_AUTH_RATE_LIMIT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
SOVA_SENSITIVE_PAYLOAD_KEY_ID=staging-v1
SOVA_SENSITIVE_PAYLOAD_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY
SOVA_MAILER_FROM=sova-staging@example.test

